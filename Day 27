#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node* next;
};
struct Node* newNode(int data) {
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));
    node->data = data;
    node->next = NULL;
    return node;
}
struct Node* buildList(int n, struct Node** tail) {
    int val;
    scanf("%d", &val);
    struct Node* head = newNode(val);
    *tail = head;

    for (int i = 1; i < n; i++) {
        scanf("%d", &val);
        (*tail)->next = newNode(val);
        *tail = (*tail)->next;
    }
    return head;
}
int getLength(struct Node* head) {
    int len = 0;
    while (head != NULL) {
        len++;
        head = head->next;
    }
    return len;
}

struct Node* getIntersection(struct Node* h1, struct Node* h2) {
    int len1 = getLength(h1);
    int len2 = getLength(h2);

    while (len1 > len2) { h1 = h1->next; len1--; }
    while (len2 > len1) { h2 = h2->next; len2--; }

    while (h1 != NULL && h2 != NULL) {
        if (h1 == h2) return h1;   // same node in memory
        h1 = h1->next;
        h2 = h2->next;
    }
    return NULL;
}

int main() {
    int n, m;

    
    scanf("%d", &n);
    struct Node* tail1 = NULL;
    struct Node* head1 = buildList(n, &tail1);

 
    scanf("%d", &m);
    struct Node* tail2 = NULL;
    struct Node* head2 = buildList(m, &tail2);

    struct Node* a = head1;
    while (a != NULL) {
        struct Node* b = head2;
        while (b != NULL) {
            if (a->data == b->data) {
         
                struct Node* x = a;
                struct Node* y = b;
                int match = 1;
                while (x != NULL && y != NULL) {
                    if (x->data != y->data) { match = 0; break; }
                    x = x->next;
                    y = y->next;
                }
                if (match && x == NULL && y == NULL) {
                    printf("%d\n", a->data);
                    return 0;
                }
            }
            b = b->next;
        }
        a = a->next;
    }

    printf("No Intersection\n");
    return 0;
}
