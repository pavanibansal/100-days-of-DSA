#include <stdio.h>
#include <limits.h>
int isPossible(int books[], int n, int m, int maxPages) {
    int students = 1;
    int pagesSum = 0;

    for (int i = 0; i < n; i++) {
        if (books[i] > maxPages)
            return 0;

        if (pagesSum + books[i] <= maxPages) {
            pagesSum += books[i];
        } else {
            students++;
            pagesSum = books[i];

            if (students > m)
                return 0;
        }
    }
    return 1;
}
int allocateBooks(int books[], int n, int m) {
    if (m > n)
        return -1;

    int low = INT_MIN, high = 0;
    for (int i = 0; i < n; i++) {
        if (books[i] > low)
            low = books[i];
        high += books[i];
    }

    int result = high;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (isPossible(books, n, m, mid)) {
            result = mid;
            high = mid - 1;  
        } else {
            low = mid + 1;   
        }
    }

    return result;
}

int main() {
    int n, m;

    scanf("%d %d", &n, &m);

    int books[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &books[i]);
    }

    int ans = allocateBooks(books, n, m);

    printf("%d\n", ans);

    return 0;
}
