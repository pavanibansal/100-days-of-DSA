#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node* next;
};

struct Node* newNode(int val) {
    struct Node* n = malloc(sizeof(struct Node));
    n->data = val;
    n->next = NULL;
    return n;
}

void deleteKey(struct Node** head, int key) {
    struct Node dummy = {0, *head};
    struct Node* cur = &dummy;

    while (cur->next) {
        if (cur->next->data == key) {
            struct Node* del = cur->next;
            cur->next = del->next;
            free(del);
            break;
        }
        cur = cur->next;
    }
    *head = dummy.next;
}

int main() {
    int n, val;
    scanf("%d", &n);

    struct Node* head = NULL;
    struct Node* tail = NULL;
    for (int i = 0; i < n; i++) {
        scanf("%d", &val);
        struct Node* node = newNode(val);
        if (!head) head = tail = node;
        else { tail->next = node; tail = node; }
    }

    int key;
    scanf("%d", &key);
    deleteKey(&head, key);

    for (struct Node* cur = head; cur; cur = cur->next)
        printf("%d%s", cur->data, cur->next ? " " : "\n");

    return 0;
}
