#include <stdio.h>
#include <string.h>

int main() {
    char s[1000];
    scanf("%s", s);
    int seen[26] = {0};  
    int n = strlen(s);
    
    for (int i = 0; i < n; i++) {
        int idx = s[i] - 'a';
        if (seen[idx]) {
            printf("%c", s[i]);
            return 0;
        }
        seen[idx] = 1;
    }
    
    printf("-1");
    return 0;
}
