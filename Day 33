#include <stdio.h>
#include <string.h>

#define MAX 100

char stack[MAX];
int top = -1;

void push(char c) {
    stack[++top] = c;
}

char pop() {
    return stack[top--];
}

char peek() {
    return stack[top];
}
int isEmpty() {
    return top == -1;
}
int isOperand(char c) {
    return (c >= 'A' && c <= 'Z') ||
           (c >= 'a' && c <= 'z') ||
           (c >= '0' && c <= '9');
}
int precedence(char c) {
    if (c == '^')           return 3;  
    if (c == '*' || c == '/') return 2;
    if (c == '+' || c == '-') return 1;
    return 0;                         
}

void infixToPostfix(char* expr) {
    int len = strlen(expr);

    for (int i = 0; i < len; i++) {
        char c = expr[i];
        if (isOperand(c)) {
            printf("%c", c);
        }

        else if (c == '(') {
            push(c);
        }
        else if (c == ')') {
            while (!isEmpty() && peek() != '(') {
                printf("%c", pop());
            }
            pop(); 
        }

        else {
            while (!isEmpty() &&
                   peek() != '(' &&
                   precedence(peek()) >= precedence(c)) {
                printf("%c", pop());
            }
            push(c);
        }
    }


    while (!isEmpty()) {
        printf("%c", pop());
    }
    printf("\n");
}

int main() {
    char expr[MAX];
    scanf("%s", expr);
    infixToPostfix(expr);
    return 0;
}
