#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node* next;
} Node;

Node* createNode(int data) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    newNode->data = data;
    newNode->next = NULL;
    return newNode;
}

Node* insertAtTail(Node* head, int data) {
    Node* newNode = createNode(data);
    if (head == NULL) return newNode;

    Node* curr = head;
    while (curr->next != NULL)
        curr = curr->next;
    curr->next = newNode;
    return head;
}

void traverse(Node* head) {
    Node* curr = head;
    while (curr != NULL) {
        if (curr->next != NULL)
            printf("%d ", curr->data);
        else
            printf("%d", curr->data);
        curr = curr->next;
    }
    printf("\n");
}

void freeList(Node* head) {
    Node* curr = head;
    while (curr != NULL) {
        Node* temp = curr;
        curr = curr->next;
        free(temp);
    }
}

int main() {
    int n;
    scanf("%d", &n);

    Node* head = NULL;
    for (int i = 0; i < n; i++) {
        int val;
        scanf("%d", &val);
        head = insertAtTail(head, val);
    }

    traverse(head);
    freeList(head);
    return 0;
}
