#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int a[n];
    for (int i = 0; i < n; i++) scanf("%d", &a[i]);

    int valid = 1;
    for (int i = 0; i < n; i++) {
        int left  = 2 * i + 1;
        int right = 2 * i + 2;
        if (left  < n && a[i] > a[left])  { valid = 0; break; }
        if (right < n && a[i] > a[right]) { valid = 0; break; }
    }

    printf("%s\n", valid ? "YES" : "NO");
    return 0;
}
