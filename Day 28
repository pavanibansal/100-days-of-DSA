#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node* next;
};

// Create a new node
struct Node* newNode(int data) {
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));
    node->data = data;
    node->next = NULL;
    return node;
}
struct Node* insertAtEnd(struct Node* head, int data) {
    struct Node* node = newNode(data);

    if (head == NULL) {
        node->next = node;   // points to itself
        return node;
    }
    struct Node* temp = head;
    while (temp->next != head) {
        temp = temp->next;
    }

    temp->next = node;   // last → new node
    node->next = head;   // new node → head (circular!)
    return head;
}

// Traverse: stop when we return to head
void traverse(struct Node* head) {
    if (head == NULL) return;

    struct Node* temp = head;
    do {
        printf("%d", temp->data);
        temp = temp->next;
        if (temp != head) printf(" ");
    } while (temp != head);

    printf("\n");
}

void freeList(struct Node* head) {
    if (head == NULL) return;

    struct Node* curr = head->next;
    while (curr != head) {
        struct Node* next = curr->next;
        free(curr);
        curr = next;
    }
    free(head);
}

int main() {
    int n;
    scanf("%d", &n);

    struct Node* head = NULL;
    for (int i = 0; i < n; i++) {
        int val;
        scanf("%d", &val);
        head = insertAtEnd(head, val);
    }

    traverse(head);
    freeList(head);
    return 0;
}
