#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int vertex;
    struct Node* next;
} Node;

int main() {
    int n, m;
    scanf("%d", &n);

    Node* adj[n];
    for(int i = 0; i < n; i++)
        adj[i] = NULL;

    scanf("%d", &m);

    for(int i = 0; i < m; i++) {
        int u, v;
        scanf("%d %d", &u, &v);

        Node* newNode = (Node*)malloc(sizeof(Node));
        newNode->vertex = v;
        newNode->next = adj[u];
        adj[u] = newNode;
    }

    for(int i = 0; i < n; i++) {
        printf("%d: ", i);
        Node* temp = adj[i];
        while(temp) {
            printf("%d ", temp->vertex);
            temp = temp->next;
        }
        printf("\n");
    }

    return 0;
}
