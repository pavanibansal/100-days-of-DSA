#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAXV  100005
#define INF   0x7fffffff
struct Node {
    int dest, weight;
    struct Node* next;
};

struct Node* adj[MAXV];

void addEdge(int u, int v, int w) {
    struct Node* n1 = (struct Node*)malloc(sizeof(struct Node));
    n1->dest = v; n1->weight = w;
    n1->next = adj[u]; adj[u] = n1;

    struct Node* n2 = (struct Node*)malloc(sizeof(struct Node));
    n2->dest = u; n2->weight = w;
    n2->next = adj[v]; adj[v] = n2;
}
struct HeapNode {
    int dist, vertex;
};

struct HeapNode heap[MAXV];
int heapSize = 0;

void swap(int i, int j) {
    struct HeapNode tmp = heap[i];
    heap[i] = heap[j];
    heap[j] = tmp;
}

void heapPush(int dist, int vertex) {
    heap[heapSize].dist   = dist;
    heap[heapSize].vertex = vertex;
    int i = heapSize++;

    // Bubble up
    while (i > 0) {
        int parent = (i - 1) / 2;
        if (heap[parent].dist > heap[i].dist) {
            swap(parent, i);
            i = parent;
        } else break;
    }
}

struct HeapNode heapPop() {
    struct HeapNode top = heap[0];
    heap[0] = heap[--heapSize];
    int i = 0;

    while (1) {
        int left  = 2 * i + 1;
        int right = 2 * i + 2;
        int smallest = i;

        if (left  < heapSize && heap[left].dist  < heap[smallest].dist)
            smallest = left;
        if (right < heapSize && heap[right].dist < heap[smallest].dist)
            smallest = right;

        if (smallest != i) { swap(i, smallest); i = smallest; }
        else break;
    }
    return top;
}

int dist[MAXV];
int visited[MAXV];

void dijkstra(int src, int V) {
    for (int i = 0; i < V; i++) {
        dist[i]    = INF;
        visited[i] = 0;
    }

    dist[src] = 0;
    heapPush(0, src);

    while (heapSize > 0) {
        struct HeapNode cur = heapPop();
        int u = cur.vertex;

        if (visited[u]) continue;   // stale entry
        visited[u] = 1;

        struct Node* temp = adj[u];
        while (temp != NULL) {
            int v = temp->dest;
            int w = temp->weight;

            if (!visited[v] && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                heapPush(dist[v], v);
            }
            temp = temp->next;
        }
    }
}

int main() {
    int V = 5;
    memset(adj, 0, sizeof(adj));

    addEdge(0, 1, 4);
    addEdge(0, 2, 1);
    addEdge(2, 1, 2);
    addEdge(1, 3, 1);
    addEdge(2, 3, 5);
    addEdge(3, 4, 3);

    int src = 0;
    dijkstra(src, V);

    printf("Shortest distances from source %d:\n", src);
    for (int i = 0; i < V; i++) {
        if (dist[i] == INF)
            printf("  Node %d : INF\n", i);
        else
            printf("  Node %d : %d\n", i, dist[i]);
    }
    return 0;
}
