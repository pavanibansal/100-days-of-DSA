#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    scanf("%d", &n);

    int queue[1000], stack[1000];
    int top = -1;
    for (int i = 0; i < n; i++) {
        scanf("%d", &queue[i]);
        stack[++top] = queue[i];
    }

   
    for (int i = 0; i < n; i++) {
        queue[i] = stack[top--];
    }

    for (int i = 0; i < n; i++) {
        if (i > 0) printf(" ");
        printf("%d", queue[i]);
    }
    printf("\n");

    return 0;
}
