#include <stdio.h>
#include <string.h>

int leastInterval(char* tasks, int tasksSize, int n) {
    int freq[26] = {0};
  
    for (int i = 0; i < tasksSize; i++)
        freq[tasks[i] - 'A']++;
    

    int max_freq = 0;
    for (int i = 0; i < 26; i++)
        if (freq[i] > max_freq)
            max_freq = freq[i];
    
    int count_of_max = 0;
    for (int i = 0; i < 26; i++)
        if (freq[i] == max_freq)
            count_of_max++;
    
    int min_slots = (max_freq - 1) * (n + 1) + count_of_max;
    
    return min_slots > tasksSize ? min_slots : tasksSize;
}

int main() {
    int t;
    scanf("%d", &t);
    
    while (t--) {
        int size, n;
        scanf("%d %d", &size, &n);
        
        char tasks[10001];
        for (int i = 0; i < size; i++) {
            char task[3];
            scanf("%s", task);
            tasks[i] = task[0];
        }
        
        printf("%d\n", leastInterval(tasks, size, n));
    }
    return 0;
}
